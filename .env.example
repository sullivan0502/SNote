# Copie ce fichier en ".env" (sans le ".example") et remplis une vraie valeur.
# Le fichier ".env" lui-même est listé dans .gitignore : il ne doit JAMAIS
# être poussé sur GitHub, sinon n'importe qui peut forger des sessions
# valides sur ton site.

# Clé secrète utilisée pour signer les jetons de connexion (JWT).
# Génère une valeur aléatoire longue, par exemple avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
EDU_SECRET_KEY=change-me
